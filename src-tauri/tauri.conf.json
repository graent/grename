{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grename",
  "version": "1.0.2",
  "identifier": "com.grename.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grename · 批量重命名",
        "width": 1120,
        "height": 700,
        "minWidth": 860,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
